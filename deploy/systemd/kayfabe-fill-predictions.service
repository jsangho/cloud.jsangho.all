[Unit]
# 빠진 AI 예측을 채운다 — `fill_missing_predictions.py`.
# 저장소의 `deploy/systemd/`가 정본이다. 서버에만 두면 아무도 모르게 낡는다.
Description=KayFabe: 예측이 없는 경기를 채운다
Documentation=file:///home/ec2-user/cloud.jsangho.all/fastapi/apps/kayfabe/scripts/fill_missing_predictions.py
# 도커가 떠 있어야 exec가 붙는다. 컨테이너가 아직 안 올라왔으면 아래 ExecStart가
# 실패하고, 타이머가 다음 날 다시 부른다 — 재시도를 따로 걸지 않는 이유다.
After=docker.service
Requires=docker.service

# 실패하면 텔레그램으로 알린다. %n 은 이 유닛의 이름이다.
OnFailure=kayfabe-alert@%n.service

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/cloud.jsangho.all

# **`-T`를 쓴다** — TTY 없이 돈다. 그리고 이 명령은 stdin을 읽지 않으므로 배포
# 스크립트에서 겪은 "stdin을 먹어 치우는" 함정과는 무관하다.
#
# 경로에 `fastapi/`가 없는 것이 맞다 — 컨테이너의 작업 디렉터리가 이미
# `/app/fastapi`다(2026-09-29 실측). 호스트 경로로 착각해 `fastapi/`를 붙이면
# 파일을 못 찾는다.
ExecStart=/usr/bin/docker compose exec -T \
    -e PYTHONUTF8=1 -e PYTHONPATH=apps:. \
    backend python apps/kayfabe/scripts/fill_missing_predictions.py --apply

# 모델을 부르는 작업이라 오래 걸린다. 무료 등급 분당 한도에 맞춰 호출을 늦추므로
# 경기 여섯이면 몇 분이다. 넉넉히 두되 무한정 붙들지는 않는다.
TimeoutStartSec=1800

# **`SuccessExitStatus=0 1` 을 걷어냈다** (2026-10-07). 스크립트는 생성에 실패한
# 경기가 있으면 1 로 끝내는데(`fill_missing_predictions.py` — `return 1 if failed`),
# 그 값을 성공으로 세고 있었다. Gemini 무료 등급 한도가 소진돼 예측이 하나도 안
# 만들어진 날조차 `systemctl status` 가 초록이었다는 뜻이다.
#
# 원래 주석은 "실패해도 유닛이 죽은 상태로 남지 않게 한다 — 타이머가 다음에 다시
# 부른다"였지만, **타이머는 유닛의 지난 결과와 무관하게 다음 시각에 다시 부른다.**
# 그래서 이 줄은 재시도에 아무 역할이 없었고 알림만 막고 있었다.
#
# exit 2(인자 오류)도 실패로 남는다 — 유닛 파일이 잘못된 것이므로 알려야 맞다.

[Install]
WantedBy=multi-user.target
