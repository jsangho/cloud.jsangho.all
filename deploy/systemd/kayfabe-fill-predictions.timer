[Unit]
Description=KayFabe: 빠진 예측 채우기 (하루 한 번)

[Timer]
# **하루 한 번이면 충분하다.** 대진이 들어오는 경로가 사람의 커밋 → Vercel 배포 →
# 방문자 접속이라 분 단위로 바뀌지 않는다. 더 자주 부르면 무료 한도만 태운다.
#
# 06:40 UTC = 한국 15:40. 새벽이 아닌 시각을 고른 이유는 **사람이 깨어 있을 때
# 돌아야** 이상한 예측이 생겼을 때 그날 안에 알아챌 수 있기 때문이다.
OnCalendar=*-*-* 06:40:00 UTC

# 서버가 꺼져 있던 동안의 실행을 부팅 뒤에 한 번 따라잡는다. 예측은 대회 전에
# 만들어져야 뜻이 있으므로, 하루를 통째로 건너뛰면 그 경기가 영영 빈다.
Persistent=true

# 정각에 몰리지 않게 흩는다. 이 서버의 다른 타이머와 겹쳐 봐야 좋을 것이 없다.
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
