        { "code": "explain", "label": "왜 그랬는지 설명한다", "risk": "bold",
          "effects": { "popularity": 2, "inRing": -1, "backstage": 4 }, "injuryRisk": 0.0 },
        { "code": "walk_out", "label": "듣지 않고 나가 버린다", "risk": "reckless",
          "effects": { "popularity": 6, "inRing": -2, "backstage": -22, "alignment": -12 },
          "injuryRisk": 0.0, "flags": ["locker_room_grudge"] }
