# Git
.git
.gitignore
.gitmodules
.github

# 환경 변수 (보안)
# Docker 무시 패턴은 gitignore와 달리 컨텍스트 루트에 고정되므로, 하위 경로용
# `**/` 형태를 반드시 함께 둔다 — Dockerfile이 `COPY fastapi/ fastapi/` 를 하기
# 때문에 이게 없으면 fastapi/.env 가 이미지에 그대로 들어간다.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Python 캐시
__pycache__
**/__pycache__
*.pyc
*.pyo
*.pyd
.ruff_cache
.import_linter_cache
.mypy_cache
.pytest_cache

# 가상환경
.venv
**/.venv
venv
pytorch_env/

# 로컬 LLM 가중치 (이미지에 안 넣음 — 온프레미스 볼륨/외부 스토리지 사용)
fastapi/Qwen2.5-1.5B-Instruct/
fastapi/EXAONE*/

# 문서
*.md
CLAUDE.md
_docs
**/_docs

# 개발 도구 설정
.cursorrules
.importlinter
.vscode
.idea
.obsidian
.claude
.markdownlint.yaml
.prettierrc

# fastapi 빌드 컨텍스트에 불필요한 다른 스택
www/
flutter/
scripts/
data/

# Docker 파일 자체
Dockerfile
fastapi/Dockerfile
.dockerignore

# 테스트
tests
**/tests

# 커버리지
htmlcov
coverage
